---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title | xml_escape }} · {{ site.tagline | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | strip | xml_escape }}</subtitle>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{{ site.posts.first.date | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.author.url }}</uri>
  </author>
  {%- for post in site.posts limit: 20 %}
  {%- assign post_lang = post.lang | default: site.lang %}
  <entry xml:lang="{{ post_lang }}">
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <author>
      <name>{{ site.author.name | xml_escape }}</name>
      <uri>{{ site.author.url }}</uri>
    </author>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <summary type="text">{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 280 | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
