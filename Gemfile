source "https://rubygems.org"

# GitHub Pages 使用 Jekyll 3.9.x；kramdown 固定 1.x，GFM 内置，
# 避免 Ruby 2.6 环境下 kramdown 2.5（要求 Ruby >= 2.7）导致的依赖错误。
gem "jekyll", "~> 3.9.3"
gem "kramdown", "~> 1.17"
gem "rouge", "~> 3.30"
# kramdown 1.17 requires rexml, which is not bundled with all Ruby runtimes.
gem "rexml", "~> 3.2"
